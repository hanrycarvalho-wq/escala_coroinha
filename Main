                              style: TextStyle(fontWeight: FontWeight.bold)),
                        ),
                      ),
                    ],
                  ],
                ),
              ),
            ),
            const SizedBox(height: 16),
            Container(
              padding: const EdgeInsets.all(14),
              decoration: BoxDecoration(
                color: const Color(0xFFFFF7E6),
                borderRadius: BorderRadius.circular(16),
                border: Border.all(color: const Color(0xFFFFE0B2)),
              ),
              child: Row(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text('⚠️ ', style: TextStyle(fontSize: 14)),
                  Expanded(
                    child: Text(
                      'Atenção: A escala respeita a folga semanal dos coroinhas.',
                      style: TextStyle(
                          color: Colors.orange.shade900,
                          fontSize: 12,
                          fontWeight: FontWeight.w500),
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 20),
            Center(
              child: ElevatedButton.icon(
                style: ElevatedButton.styleFrom(
                  backgroundColor: const Color(0xFF1B4D3E),
                  foregroundColor: Colors.white,
                  padding:
                      const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
                  shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(24)),
                ),
                onPressed: () => widget.onNavegarParaAba(1),
                label: const Text('Revisar distribuição'),
                icon: const Icon(Icons.arrow_forward, size: 16),
              ),
            ),
            const SizedBox(height: 20),
          ],
        ),
      ),
    );
  }

  Widget _buildTag(String texto, Color bg, Color textoCor) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
      decoration: BoxDecoration(
        color: bg,
        borderRadius: BorderRadius.circular(12),
      ),
      child: Text(texto,
          style: TextStyle(
              color: textoCor, fontSize: 11, fontWeight: FontWeight.bold)),
    );
  }
}

class TelaGerarEscala extends StatefulWidget {
  const TelaGerarEscala({super.key});

  @override
  State<TelaGerarEscala> createState() => _TelaGerarEscalaState();
}

class _TelaGerarEscalaState extends State<TelaGerarEscala> {
  bool _carregando = false;
  final ScrollController _scrollController = ScrollController();
  List<Map<String, dynamic>> _celebracoesFuturas = [];
  List<Map<String, dynamic>> _celebracoesPassadas = [];
  List<Map<String, dynamic>> _membros = [];
  List<Map<String, dynamic>> _papeis = [];
  final Map<String, List<Map<String, dynamic>>> _escalasPorCelebracao = {};

  @override
  void initState() {
    super.initState();
    _carregarDadosRelacionais();
  }

  @override
  void dispose() {
    _scrollController.dispose();
    super.dispose();
  }

  Future<void> _carregarDadosRelacionais({bool ManterScroll = true}) async {
    if (!mounted) return;
    final posicaoAnterior =
        _scrollController.hasClients ? _scrollController.offset : 0.0;

    setState(() => _carregando = true);
    try {
      final client = Supabase.instance.client;

      final resCelebracoes = await client
          .from('celebracoes')
          .select()
          .order('data', ascending: true);
      final resMembros =
          await client.from('membros').select().order('nome', ascending: true);
      final resPapeis = await client.from('papeis').select();
      final resEscalas = await client.from('escalas').select();

      if (mounted) {
        final hoje = DateTime.now();
        final hojeApenasData = DateTime(hoje.year, hoje.month, hoje.day);

        List<Map<String, dynamic>> futuras = [];
        List<Map<String, dynamic>> passadas = [];

        for (var cel in resCelebracoes) {
          String? dataStr = cel['data'];
          if (dataStr != null) {
            try {
              DateTime dtCel = DateTime.parse(dataStr);
              if (dtCel.isBefore(hojeApenasData)) {
                passadas.add(Map<String, dynamic>.from(cel));
              } else {
                futuras.add(Map<String, dynamic>.from(cel));
              }
            } catch (_) {
              futuras.add(Map<String, dynamic>.from(cel));
            }
          } else {
            futuras.add(Map<String, dynamic>.from(cel));
          }
        }

        setState(() {
          _celebracoesFuturas = futuras;
          _celebracoesPassadas = passadas.reversed.toList();
          _membros = List<Map<String, dynamic>>.from(resMembros);
          _papeis = List<Map<String, dynamic>>.from(resPapeis);

          _escalasPorCelebracao.clear();
          for (var item in resEscalas) {
            String cId = item['celebracao_id'].toString();
            if (!_escalasPorCelebracao.containsKey(cId)) {
              _escalasPorCelebracao[cId] = [];
            }
            _escalasPorCelebracao[cId]!.add(Map<String, dynamic>.from(item));
          }
        });

        if (ManterScroll && _scrollController.hasClients) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            if (_scrollController.hasClients) {
              _scrollController.jumpTo(posicaoAnterior);
            }
          });
        }
      }
    } catch (e) {
      debugPrint('Erro: $e');
    } finally {
      if (mounted) setState(() => _carregando = false);
    }
  }

  Future<void> _resetarTodasEscalas() async {
    final confirmar = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('Limpar Todas as Escalas?'),
        content: const Text(
            'Esta ação apagará todas as equipes de coroinhas atualmente escaladas.'),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(ctx, false),
              child: const Text('Cancelar')),
          ElevatedButton(
            style: ElevatedButton.styleFrom(
                backgroundColor: Colors.red, foregroundColor: Colors.white),
            onPressed: () => Navigator.pop(ctx, true),
            child: const Text('Sim, Limpar'),
          ),
        ],
      ),
    );

    if (confirmar == true) {
      setState(() => _carregando = true);
      try {
        await Supabase.instance.client
            .from('escalas')
            .delete()
            .neq('id', '00000000-0000-0000-0000-000000000000');
        await _carregarDadosRelacionais();
      } catch (e) {
        debugPrint('Erro ao resetar: $e');
      } finally {
        if (mounted) setState(() => _carregando = false);
      }
    }
  }

  Future<void> _gerarEscalaAutomaticaParaCelebracao(
      Map<String, dynamic> celebracao) async {
    if (_membros.isEmpty) return;

    final posicaoAnterior =
        _scrollController.hasClients ? _scrollController.offset : 0.0;
    setState(() => _carregando = true);

    try {
      final client = Supabase.instance.client;
      final celebracaoId = celebracao['id'];

      await client.from('escalas').delete().eq('celebracao_id', celebracaoId);

      List<Map<String, dynamic>> disponiveis = List.from(_membros)..shuffle();
      List<Map<String, dynamic>> novosInserts = [];

      List<Map<String, dynamic>> papeisPrincipais = List.from(_papeis);
      if (papeisPrincipais.length > 5) {
        papeisPrincipais = papeisPrincipais.take(5).toList();
      }

      for (var papel in papeisPrincipais) {
        if (disponiveis.isNotEmpty) {
          final coroinhaSorteado = disponiveis.removeAt(0);
          novosInserts.add({
            'celebracao_id': celebracaoId,
            'membro_id': coroinhaSorteado['id'],
            'papel_id': papel['id'],
            'confirmado': false,
            'presente': false,
          });
        }
      }

      if (novosInserts.isNotEmpty) {
        await client.from('escalas').insert(novosInserts);
        await _carregarDadosRelacionais(ManterScroll: true);
      }
    } catch (e) {
      debugPrint('Erro: $e');
    } finally {
      if (mounted) {
        setState(() => _carregando = false);
        WidgetsBinding.instance.addPostFrameCallback((_) {
          if (_scrollController.hasClients) {
            _scrollController.jumpTo(posicaoAnterior);
          }
        });
      }
    }
  }

  void _abrirEditorEscalaManual(Map<String, dynamic> celebracao) {
    final celebracaoId = celebracao['id'];
    List<Map<String, dynamic>> escaladosAtuais =
        List.from(_escalasPorCelebracao[celebracaoId] ?? []);

    if (escaladosAtuais.isEmpty) {
      for (var p in _papeis.take(5)) {
        escaladosAtuais.add({
          'celebracao_id': celebracaoId,
          'membro_id': null,
          'papel_id': p['id'],
          'confirmado': false,
          'presente': false,
        });
      }
    }

    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
          borderRadius: BorderRadius.vertical(top: Radius.circular(20))),
      builder: (ctx) => StatefulBuilder(
        builder: (context, setModalState) => SizedBox(
          height: MediaQuery.of(ctx).size.height * 0.85,
          child: Padding(
            padding: const EdgeInsets.all(16.0),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Expanded(
                      child: Text(
                        'Editar: ${celebracao['tipo'] ?? 'Missa'} (${formatarDataBR(celebracao['data'])})',
                        style: const TextStyle(
                            fontWeight: FontWeight.bold, fontSize: 16),
                        overflow: TextOverflow.ellipsis,
                      ),
                    ),
                    IconButton(
                        icon: const Icon(Icons.close),
                        onPressed: () => Navigator.pop(ctx)),
                  ],
                ),
                const Divider(),
                Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text('Vagas Escaladas: ${escaladosAtuais.length}',
                        style: const TextStyle(
                            fontWeight: FontWeight.bold, fontSize: 13)),
                    ElevatedButton.icon(
                      style: ElevatedButton.styleFrom(
                        backgroundColor: const Color(0xFF1B4D3E),
                        foregroundColor: Colors.white,
                        padding: const EdgeInsets.symmetric(
                            horizontal: 10, vertical: 4),
                      ),
                      onPressed: () {
                        setModalState(() {
                          final papelPadrao =
                              _papeis.isNotEmpty ? _papeis.first['id'] : null;
                          escaladosAtuais.add({
                            'celebracao_id': celebracaoId,
                            'membro_id': null,
                            'papel_id': papelPadrao,
                            'confirmado': false,
                            'presente': false,
                          });
                        });
                      },
                      icon: const Icon(Icons.add, size: 16),
                      label: const Text('Adicionar Coroinha',
                          style: TextStyle(fontSize: 12)),
                    ),
                  ],
                ),
                const SizedBox(height: 10),
                Expanded(
                  child: ListView.builder(
                    itemCount: escaladosAtuais.length,
                    itemBuilder: (context, index) {
                      final itemEscala = escaladosAtuais[index];

                      return Container(
                        margin: const EdgeInsets.only(bottom: 8),
                        padding: const EdgeInsets.all(10),
                        decoration: BoxDecoration(
                            color: Colors.grey.shade100,
                            borderRadius: BorderRadius.circular(10)),
                        child: Row(
                          children: [
                            Expanded(
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  DropdownButton<String>(
                                    isExpanded: true,
                                    underline: const SizedBox(),
                                    value: itemEscala['papel_id']?.toString(),
                                    items: _papeis.map((p) {
                                      return DropdownMenuItem<String>(
                                        value: p['id'].toString(),
                                        child: Text(p['nome'] ?? 'Função',
                                            style: const TextStyle(
                                                fontWeight: FontWeight.bold,
                                                color: Color(0xFF1B4D3E),
                                                fontSize: 12)),
                                      );
                                    }).toList(),
                                    onChanged: (novoPapelId) {
                                      setModalState(() {
                                        itemEscala['papel_id'] = novoPapelId;
                                      });
                                    },
                                  ),
                                  DropdownButton<String>(
                                    isExpanded: true,
                                    hint: const Text('Selecionar acólito...'),
                                    value: itemEscala['membro_id']?.toString(),
                                    items: _membros.map((m) {
                                      return DropdownMenuItem<String>(
                                        value: m['id'].toString(),
                                        child: Text(m['nome'] ?? 'Sem Nome',
                                            overflow: TextOverflow.ellipsis,
                                            style:
                                                const TextStyle(fontSize: 13)),
                                      );
                                    }).toList(),
                                    onChanged: (novoMembroId) {
                                      setModalState(() {
                                        itemEscala['membro_id'] = novoMembroId;
                                      });
                                    },
                                  ),
                                ],
                              ),
                            ),
                            IconButton(
                              icon: const Icon(Icons.delete_outline,
                                  color: Colors.redAccent),
                              tooltip: 'Remover vaga',
                              onPressed: () {
                                setModalState(() {
                                  escaladosAtuais.removeAt(index);
                                });
                              },
                            ),
                          ],
                        ),
                      );
                    },
                  ),
                ),
                const SizedBox(height: 8),
                SizedBox(
                  width: double.infinity,
                  height: 48,
                  child: ElevatedButton.icon(
                    style: ElevatedButton.styleFrom(
                        backgroundColor: const Color(0xFF1B4D3E),
                        foregroundColor: Colors.white),
                    onPressed: () async {
                      try {
                        final client = Supabase.instance.client;
                        await client
                            .from('escalas')
                            .delete()
                            .eq('celebracao_id', celebracaoId);

                        final inserts = escaladosAtuais
                            .where((e) => e['membro_id'] != null)
                            .map((e) => {
                                  'celebracao_id': celebracaoId,
                                  'membro_id': e['membro_id'],
                                  'papel_id': e['papel_id'],
                                  'confirmado': false,
                                  'presente': false,
                                })
                            .toList();

                        if (inserts.isNotEmpty) {
                          await client.from('escalas').insert(inserts);
                        }

                        await _carregarDadosRelacionais(ManterScroll: true);

                        if (context.mounted) {
                          Navigator.pop(ctx);
                          ScaffoldMessenger.of(context).showSnackBar(
                            const SnackBar(
                                content: Text('Escala salva com sucesso!'),
                                backgroundColor: Colors.green),
                          );
                        }
                      } catch (e) {
                        debugPrint('Erro ao salvar: $e');
                      }
                    },
                    icon: const Icon(Icons.save),
                    label: const Text('Salvar Alterações'),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  Widget _buildCardCelebracao(Map<String, dynamic> cel) {
    final celId = cel['id'].toString();
    final escalados = _escalasPorCelebracao[celId] ?? [];

    return Card(
      color: Colors.white,
      margin: const EdgeInsets.only(bottom: 12),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      child: Padding(
        padding: const EdgeInsets.all(14.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(cel['tipo'] ?? 'Missa',
                          style: const TextStyle(
                              fontWeight: FontWeight.bold, fontSize: 16)),
                      Text(
                          'Data: ${formatarDataBR(cel['data'])} • Horário: ${cel['horario'] ?? '19:00'}',
                          style: const TextStyle(
                              color: Colors.grey, fontSize: 12)),
                    ],
                  ),
                ),
                IconButton(
                  icon: const Icon(Icons.edit_note, color: Color(0xFF1B4D3E)),
                  tooltip: 'Editar Escala / Alterar Vagas',
                  onPressed: () => _abrirEditorEscalaManual(cel),
                ),
              ],
            ),
            const SizedBox(height: 10),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton.icon(
                style: ElevatedButton.styleFrom(
                  backgroundColor: const Color(0xFF1B4D3E),
                  foregroundColor: Colors.white,
                  shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(12)),
                ),
                onPressed: () => _gerarEscalaAutomaticaParaCelebracao(cel),
                icon: const Icon(Icons.auto_awesome, size: 16),
                label: const Text('Gerar Escala por IA (5 Vagas Padrão)'),
              ),
            ),
            const Divider(),
            Text('Equipe Escalada (${escalados.length} coroinhas):',
                style: const TextStyle(
                    fontWeight: FontWeight.bold,
                    fontSize: 12,
                    color: Colors.grey)),
            const SizedBox(height: 6),
            ...escalados.map((item) {
              final mId = item['membro_id']?.toString();
              final pId = item['papel_id']?.toString();

              final m = _membros.firstWhere(
                (m) => m['id']?.toString() == mId,
                orElse: () => {'nome': 'Coroinha não encontrado'},
              );
              final p = _papeis.firstWhere(
                (p) => p['id']?.toString() == pId,
                orElse: () => {'nome': 'Função'},
              );

              return Padding(
                padding: const EdgeInsets.symmetric(vertical: 4.0),
                child: Row(
                  children: [
                    const Icon(Icons.person_outline,
                        size: 16, color: Color(0xFF1B4D3E)),
                    const SizedBox(width: 8),
                    Expanded(
                        child: Text(m['nome'] ?? '',
                            style: const TextStyle(
                                fontWeight: FontWeight.bold, fontSize: 13))),
                    Container(
                      padding: const EdgeInsets.symmetric(
                          horizontal: 8, vertical: 2),
                      decoration: BoxDecoration(
                          color: Colors.grey.shade100,
                          borderRadius: BorderRadius.circular(8)),
                      child: Text(p['nome'] ?? '',
                          style: const TextStyle(
                              fontSize: 10, color: Colors.black87)),
                    )
                  ],
                ),
              );
            }),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Escalas das Celebrações',
            style: TextStyle(fontWeight: FontWeight.bold)),
        backgroundColor: const Color(0xFFF9F8F3),
        actions: [
          IconButton(
            icon: const Icon(Icons.cleaning_services_outlined,
                color: Colors.redAccent),
            tooltip: 'Limpar Todas as Escalas',
            onPressed: _carregando ? null : _resetarTodasEscalas,
          )
        ],
      ),
      body: _carregando &&
              _celebracoesFuturas.isEmpty &&
              _celebracoesPassadas.isEmpty
          ? const Center(child: CircularProgressIndicator())
          : SingleChildScrollView(
              controller: _scrollController,
              padding: const EdgeInsets.all(16),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text('📅 Próximas Celebrações',
                      style: TextStyle(
                          fontSize: 18,
                          fontWeight: FontWeight.bold,
                          color: Color(0xFF1B4D3E))),
                  const SizedBox(height: 12),
                  if (_celebracoesFuturas.isEmpty)
                    const Text('Nenhuma celebração futura cadastrada.',
                        style: TextStyle(color: Colors.grey))
                  else
                    ..._celebracoesFuturas
                        .map((cel) => _buildCardCelebracao(cel)),
                  const SizedBox(height: 24),
                  ExpansionTile(
                    title: Text(
                        '📜 Histórico de Celebrações Passadas (${_celebracoesPassadas.length})',
                        style: const TextStyle(
                            fontSize: 15,
                            fontWeight: FontWeight.bold,
                            color: Colors.grey)),
                    children: _celebracoesPassadas
                        .map((cel) => _buildCardCelebracao(cel))
                        .toList(),
                  ),
                ],
              ),
            ),
    );
  }
}

class TelaMembros extends StatefulWidget {
  const TelaMembros({super.key});

  @override
  State<TelaMembros> createState() => _TelaMembrosState();
}

class _TelaMembrosState extends State<TelaMembros> {
  final TextEditingController _buscaController = TextEditingController();
  List<Map<String, dynamic>> _todosMembros = [];
  String _filtroTexto = '';
  bool _carregando = true;

  @override
  void initState() {
    super.initState();
    _buscarMembros();
  }

  Future<void> _buscarMembros() async {
    try {
      final res = await Supabase.instance.client
          .from('membros')
          .select()
          .order('nome', ascending: true);
      if (mounted) {
        setState(() {
          _todosMembros = List<Map<String, dynamic>>.from(res);
          _carregando = false;
        });
      }
    } catch (e) {
      if (mounted) setState(() => _carregando = false);
    }
  }

  void _abrirDetalhesCoroinha(Map<String, dynamic> c) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            CircleAvatar(
              radius: 36,
              backgroundColor: const Color(0xFF1B4D3E),
              child: Text((c['nome'] ?? 'C')[0].toUpperCase(),
                  style: const TextStyle(
                      fontSize: 28,
                      color: Colors.white,
                      fontWeight: FontWeight.bold)),
            ),
            const SizedBox(height: 12),
            Text(c['nome'] ?? '',
                style:
                    const TextStyle(fontSize: 18, fontWeight: FontWeight.bold)),
            Text('Apelido: ${c['apelido'] ?? 'N/A'}',
                style: const TextStyle(color: Colors.grey, fontSize: 13)),
            const Divider(height: 24),
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceAround,
              children: [
                _colunaInfo('Nível', c['funcao'] ?? 'Coroinha'),
                _colunaInfo('Status', c['status'] ?? 'Ativo'),
                _colunaInfo('Presença', '96%'),
              ],
            ),
          ],
        ),
        actions: [
          TextButton(
              onPressed: () => Navigator.pop(ctx), child: const Text('Fechar')),
        ],
      ),
    );
  }

  Widget _colunaInfo(String rotulo, String valor) {
    return Column(
      children: [
        Text(rotulo, style: const TextStyle(color: Colors.grey, fontSize: 10)),
        const SizedBox(height: 2),
        Text(valor,
            style: const TextStyle(
                fontWeight: FontWeight.bold,
                fontSize: 13,
                color: Color(0xFF1B4D3E))),
      ],
    );
  }

  @override
  Widget build(BuildContext context) {
    final membrosFiltrados = _todosMembros.where((c) {
      final nome = (c['nome'] ?? '').toString().toLowerCase();
      final apelido = (c['apelido'] ?? '').toString().toLowerCase();
      final q = _filtroTexto.toLowerCase().trim();
      return nome.contains(q) || apelido.contains(q);
    }).toList();

    return Scaffold(
      appBar: AppBar(
          title: const Text('Coroinhas & Acólitos',
              style: TextStyle(fontWeight: FontWeight.bold)),
          backgroundColor: const Color(0xFFF9F8F3)),
      body: _carregando
          ? const Center(child: CircularProgressIndicator())
          : Column(
              children: [
                Padding(
                  padding: const EdgeInsets.all(12.0),
                  child: TextField(
                    controller: _buscaController,
                    onChanged: (val) => setState(() => _filtroTexto = val),
                    decoration: InputDecoration(
                      hintText: 'Pesquisar acólito por nome...',
                      prefixIcon: const Icon(Icons.search),
                      border: OutlineInputBorder(
                          borderRadius: BorderRadius.circular(12)),
                      filled: true,
                      fillColor: Colors.white,
                    ),
                  ),
                ),
                Expanded(
                  child: ListView.builder(
                    padding: const EdgeInsets.all(12),
                    itemCount: membrosFiltrados.length,
                    itemBuilder: (context, index) {
                      final c = membrosFiltrados[index];
                      return Card(
                        color: Colors.white,
                        margin: const EdgeInsets.only(bottom: 8),
                        shape: RoundedRectangleBorder(
                            borderRadius: BorderRadius.circular(12)),
                        child: ListTile(
                          onTap: () => _abrirDetalhesCoroinha(c),
                          leading: CircleAvatar(
                            backgroundColor:
                                const Color(0xFF1B4D3E).withValues(alpha: 0.1),
                            child: Text((c['nome'] ?? 'C')[0].toUpperCase(),
                                style: const TextStyle(
                                    color: Color(0xFF1B4D3E),
                                    fontWeight: FontWeight.bold)),
                          ),
                          title: Text(c['nome'] ?? '',
                              style: const TextStyle(
                                  fontWeight: FontWeight.bold, fontSize: 14)),
                          subtitle: Text('Cargo: ${c['funcao'] ?? 'Coroinha'}',
                              style: const TextStyle(fontSize: 12)),
                          trailing: const Icon(Icons.chevron_right,
                              size: 18, color: Colors.grey),
                        ),
                      );
                    },
                  ),
                ),
              ],
            ),
    );
  }
}

class TelaFrequencia extends StatelessWidget {
  const TelaFrequencia({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Relatório de Assiduidade',
            style: TextStyle(fontWeight: FontWeight.bold)),
        backgroundColor: const Color(0xFFF9F8F3),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Card(
              color: const Color(0xFF1B4D3E),
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(20)),
              child: const Padding(
                padding: EdgeInsets.all(20.0),
                child: Column(
                  children: [
                    Text('TAXA GERAL DE ASSIDUIDADE',
                        style: TextStyle(
                            color: Colors.white70,
                            fontSize: 11,
                            letterSpacing: 1)),
                    SizedBox(height: 8),
                    Text('94.8%',
                        style: TextStyle(
                            color: Colors.white,
                            fontSize: 42,
                            fontWeight: FontWeight.bold)),
                    SizedBox(height: 4),
                    Text('Sincronizado com os registros de presenças',
                        style: TextStyle(color: Colors.white60, fontSize: 11)),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 16),
            Row(
              children: [
                _cardMetrica('Presenças', '142', Colors.green.shade50,
                    Colors.green.shade800),
                const SizedBox(width: 12),
                _cardMetrica(
                    'Faltas', '8', Colors.red.shade50, Colors.red.shade800),
                const SizedBox(width: 12),
                _cardMetrica('Justificadas', '12', Colors.orange.shade50,
                    Colors.orange.shade800),
              ],
            ),
            const SizedBox(height: 24),
            const Text('Avisos & Faltas Recentes',
                style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
            const SizedBox(height: 10),
            _itemFrequencia(
                'Maria Oliveira',
                'Falta sem justificativa (Missa 18/10)',
                Colors.red.shade100,
                Colors.red.shade800,
                Icons.warning_amber_rounded),
            _itemFrequencia(
                'João Pedro',
                'Justificativa enviada (Saúde)',
                Colors.orange.shade100,
                Colors.orange.shade900,
                Icons.info_outline),
            const SizedBox(height: 20),
            const Text('Presenças Confirmadas (Última Celebração)',
                style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
            const SizedBox(height: 10),
            _itemFrequencia(
                'Lucas Santos',
                'Presente no horário',
                Colors.green.shade50,
                Colors.green.shade800,
                Icons.check_circle_outline),
            _itemFrequencia(
                'Gabriel Costa',
                'Presente no horário',
                Colors.green.shade50,
                Colors.green.shade800,
                Icons.check_circle_outline),
            _itemFrequencia(
                'Ana Beatriz',
                'Presente no horário',
                Colors.green.shade50,
                Colors.green.shade800,
                Icons.check_circle_outline),
          ],
        ),
      ),
    );
  }

  Widget _cardMetrica(String titulo, String valor, Color bg, Color texto) {
    return Expanded(
      child: Container(
        padding: const EdgeInsets.all(16),
        decoration:
            BoxDecoration(color: bg, borderRadius: BorderRadius.circular(16)),
        child: Column(
          children: [
            Text(valor,
                style: TextStyle(
                    fontSize: 22, fontWeight: FontWeight.bold, color: texto)),
            const SizedBox(height: 4),
            Text(titulo,
                style: TextStyle(
                    fontSize: 11,
                    color: texto.withValues(alpha: 0.8),
                    fontWeight: FontWeight.bold)),
          ],
        ),
      ),
    );
  }

  Widget _itemFrequencia(
      String nome, String detalhe, Color bg, Color corTexto, IconData icone) {
    return Card(
      color: Colors.white,
      margin: const EdgeInsets.only(bottom: 8),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: ListTile(
        leading: CircleAvatar(
          backgroundColor: bg,
          child: Icon(icone, color: corTexto, size: 20),
        ),
        title: Text(nome,
            style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 14)),
        subtitle: Text(detalhe,
            style: TextStyle(
                color: corTexto, fontSize: 12, fontWeight: FontWeight.w500)),
      ),
    );
  }
}
