import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:supabase_flutter/supabase_flutter.dart';

class SupabaseConfig {
  static const String url = '';
  static const String publishableKey =
      '';
}

void main() async {
  WidgetsFlutterBinding.ensureInitialized();

  FlutterError.onError = (FlutterErrorDetails details) {
    FlutterError.presentError(details);
    debugPrint('🛑 Erro Flutter: ${details.exception}');
  };

  try {
    final cleanUrl = SupabaseConfig.url.trim();
    final cleanKey = SupabaseConfig.publishableKey.trim();

    await Supabase.initialize(
      url: cleanUrl,
      publishableKey: cleanKey,
    );
  } catch (e) {
    debugPrint('🛑 Erro fatal ao inicializar Supabase: $e');
  }

  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Pastoral dos Coroinhas',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        scaffoldBackgroundColor: const Color(0xFFF9F8F3),
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF1B4D3E),
          primary: const Color(0xFF1B4D3E),
          surface: const Color(0xFFF9F8F3),
        ),
      ),
      home: const TelaLoginGuard(),
    );
  }
}

String formatarDataBR(String? dataIso) {
  if (dataIso == null || dataIso.isEmpty) return 'Data N/A';
  try {
    final partes = dataIso.split('T')[0].split('-');
    if (partes.length == 3) {
      return '${partes[2]}/${partes[1]}/${partes[0]}';
    }
  } catch (_) {}
  return dataIso;
}

class TelaLoginGuard extends StatefulWidget {
  const TelaLoginGuard({super.key});

  @override
  State<TelaLoginGuard> createState() => _TelaLoginGuardState();
}

class _TelaLoginGuardState extends State<TelaLoginGuard> {
  final _emailController = TextEditingController();
  final _senhaController = TextEditingController();
  bool _carregando = false;
  String? _mensagemErro;

  Future<void> _fazerLogin() async {
    setState(() {
      _carregando = true;
      _mensagemErro = null;
    });

    try {
      final email = _emailController.text.trim();
      final senha = _senhaController.text.trim();

      if (email.isEmpty || senha.isEmpty) {
        throw 'Por favor, preencha o e-mail e a senha.';
      }

      final response = await Supabase.instance.client.auth.signInWithPassword(
        email: email,
        password: senha,
      );

      if (response.user != null && mounted) {
        Navigator.pushReplacement(
          context,
          MaterialPageRoute(builder: (_) => const TelaNavegacaoPrincipal()),
        );
      }
    } on AuthException catch (e) {
      setState(() => _mensagemErro = 'Falha no login: ${e.message}');
    } catch (e) {
      setState(() => _mensagemErro = e.toString());
    } finally {
      if (mounted) setState(() => _carregando = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Center(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(24.0),
          child: ConstrainedBox(
            constraints: const BoxConstraints(maxWidth: 380),
            child: Card(
              color: Colors.white,
              elevation: 2,
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(24)),
              child: Padding(
                padding: const EdgeInsets.all(28.0),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    const CircleAvatar(
                      radius: 36,
                      backgroundColor: Color(0xFF1B4D3E),
                      child: Icon(Icons.church, size: 36, color: Colors.white),
                    ),
                    const SizedBox(height: 16),
                    const Text(
                      'Coordenação',
                      style: TextStyle(
                          fontSize: 22,
                          fontWeight: FontWeight.bold,
                          fontFamily: 'Serif'),
                    ),
                    const Text(
                      'PASTORAL DOS COROINHAS',
                      style: TextStyle(
                          color: Colors.grey, fontSize: 11, letterSpacing: 1.2),
                    ),
                    const SizedBox(height: 24),
                    if (_mensagemErro != null)
                      Container(
                        padding: const EdgeInsets.all(10),
                        margin: const EdgeInsets.only(bottom: 16),
                        decoration: BoxDecoration(
                          color: Colors.red.shade50,
                          borderRadius: BorderRadius.circular(8),
                        ),
                        child: Text(_mensagemErro!,
                            style: const TextStyle(
                                color: Colors.red, fontSize: 12),
                            textAlign: TextAlign.center),
                      ),
                    TextField(
                      controller: _emailController,
                      decoration: InputDecoration(
                        labelText: 'E-mail do Coordenador',
                        border: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(12)),
                        filled: true,
                        fillColor: const Color(0xFFF9F8F3),
                      ),
                    ),
                    const SizedBox(height: 14),
                    TextField(
                      controller: _senhaController,
                      obscureText: true,
                      decoration: InputDecoration(
                        labelText: 'Senha',
                        border: OutlineInputBorder(
                            borderRadius: BorderRadius.circular(12)),
                        filled: true,
                        fillColor: const Color(0xFFF9F8F3),
                      ),
                    ),
                    const SizedBox(height: 20),
                    SizedBox(
                      width: double.infinity,
                      height: 48,
                      child: ElevatedButton(
                        style: ElevatedButton.styleFrom(
                          backgroundColor: const Color(0xFF1B4D3E),
                          foregroundColor: Colors.white,
                          shape: RoundedRectangleBorder(
                              borderRadius: BorderRadius.circular(12)),
                        ),
                        onPressed: _carregando ? null : _fazerLogin,
                        child: _carregando
                            ? const SizedBox(
                                width: 20,
                                height: 20,
                                child: CircularProgressIndicator(
                                    color: Colors.white, strokeWidth: 2))
                            : const Text('Acessar Sistema',
                                style: TextStyle(fontWeight: FontWeight.bold)),
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }
}

class TelaNavegacaoPrincipal extends StatefulWidget {
  const TelaNavegacaoPrincipal({super.key});

  @override
  State<TelaNavegacaoPrincipal> createState() => _TelaNavegacaoPrincipalState();
}

class _TelaNavegacaoPrincipalState extends State<TelaNavegacaoPrincipal> {
  int _abaSelecionada = 0;

  void _mudarAba(int index) {
    setState(() => _abaSelecionada = index);
  }

  @override
  Widget build(BuildContext context) {
    final List<Widget> telas = [
      TelaEscalasDesign(onNavegarParaAba: _mudarAba),
      const TelaGerarEscala(),
      const TelaMembros(),
      const TelaFrequencia(),
    ];

    return Scaffold(
      body: IndexedStack(
        index: _abaSelecionada,
        children: telas,
      ),
      bottomNavigationBar: NavigationBar(
        selectedIndex: _abaSelecionada,
        onDestinationSelected: _mudarAba,
        backgroundColor: Colors.white,
        indicatorColor: const Color(0xFF1B4D3E).withValues(alpha: 0.15),
        destinations: const [
          NavigationDestination(
              icon: Icon(Icons.calendar_today_outlined),
              selectedIcon:
                  Icon(Icons.calendar_today, color: Color(0xFF1B4D3E)),
              label: 'Início'),
          NavigationDestination(
              icon: Icon(Icons.auto_awesome_outlined),
              selectedIcon: Icon(Icons.auto_awesome, color: Color(0xFF1B4D3E)),
              label: 'Escalas'),
          NavigationDestination(
              icon: Icon(Icons.people_outline),
              selectedIcon: Icon(Icons.people, color: Color(0xFF1B4D3E)),
              label: 'Coroinhas'),
          NavigationDestination(
              icon: Icon(Icons.bar_chart_outlined),
              selectedIcon: Icon(Icons.bar_chart, color: Color(0xFF1B4D3E)),
              label: 'Frequência'),
        ],
      ),
    );
  }
}

class TelaEscalasDesign extends StatefulWidget {
  final Function(int) onNavegarParaAba;

  const TelaEscalasDesign({super.key, required this.onNavegarParaAba});

  @override
  State<TelaEscalasDesign> createState() => _TelaEscalasDesignState();
}

class _TelaEscalasDesignState extends State<TelaEscalasDesign> {
  int diaSelecionadoIndex = 4;
  int mesAtualIndex = 0;
  bool cardMissaExpandido = true;

  final List<String> meses = [
    'Outubro de 2026',
    'Novembro de 2026',
    'Dezembro de 2026'
  ];

  final List<Map<String, String>> diasSemana = [
    {'dia': 'QUI', 'num': '15', 'dataIso': '2026-10-15'},
    {'dia': 'SEX', 'num': '16', 'dataIso': '2026-10-16'},
    {'dia': 'SÁB', 'num': '17', 'dataIso': '2026-10-17'},
    {'dia': 'DOM', 'num': '18', 'dataIso': '2026-10-18'},
    {'dia': 'SEG', 'num': '19', 'dataIso': '2026-10-19'},
    {'dia': 'TER', 'num': '20', 'dataIso': '2026-10-20'},
    {'dia': 'QUA', 'num': '21', 'dataIso': '2026-10-21'},
  ];

  Future<void> _copiarTextoWhatsApp() async {
    final itemDia = diasSemana[diaSelecionadoIndex];
    final dataIso = itemDia['dataIso'] ?? '';
    final dataFormatada = formatarDataBR(dataIso);

    String listaEquipe = '• NENHUM COROINHA ESCALADO AINDA';

    try {
      final client = Supabase.instance.client;
      final celRes = await client
          .from('celebracoes')
          .select()
          .eq('data', dataIso)
          .maybeSingle();

      if (celRes != null && celRes['id'] != null) {
        final celId = celRes['id'];
        final escalasRes = await client
            .from('escalas')
            .select('membro_id, papel_id')
            .eq('celebracao_id', celId);

        if (escalasRes.isNotEmpty) {
          final membrosRes = await client.from('membros').select('id, nome');
          final papeisRes = await client.from('papeis').select('id, nome');

          final Map<String, String> mapaMembros = {
            for (var m in membrosRes) m['id'].toString(): m['nome'] ?? ''
          };
          final Map<String, String> mapaPapeis = {
            for (var p in papeisRes) p['id'].toString(): p['nome'] ?? ''
          };

          List<String> linhas = [];
          for (var esc in escalasRes) {
            final mNome =
                mapaMembros[esc['membro_id']?.toString()] ?? 'Coroinha';
            final pNome = mapaPapeis[esc['papel_id']?.toString()] ?? 'Função';
            linhas.add('• $pNome: $mNome');
          }
          if (linhas.isNotEmpty) {
            listaEquipe = linhas.join('\n');
          }
        }
      }
    } catch (e) {
      debugPrint('Erro ao buscar nomes reais para o WhatsApp: $e');
    }

    final textoEscala = '''
📌 *ESCALA DOS COROINHAS - CSJB*
📅 *Data:* $dataFormatada (${itemDia['dia']}-feira)
⏰ *Horário:* 19:00h
⛪ *Celebração:* Missa do Tempo Comum

👥 *EQUIPE ESCALADA:*
$listaEquipe

Por favor, confirmem a presença no grupo! 🙏
''';

    try {
      await Clipboard.setData(ClipboardData(text: textoEscala));
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text(
                '📋 Escala copiada com sucesso! Abra o WhatsApp e cole no grupo.'),
            backgroundColor: Color(0xFF1B4D3E),
            duration: Duration(seconds: 3),
          ),
        );
      }
    } catch (_) {
      if (mounted) {
        showDialog(
          context: context,
          builder: (ctx) => AlertDialog(
            title: const Text('📋 Escala Formatada'),
            content: SelectableText(textoEscala),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(ctx),
                child: const Text('Fechar'),
              ),
            ],
          ),
        );
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    final itemDia = diasSemana[diaSelecionadoIndex];

    return Scaffold(
      drawer: Drawer(
        child: ListView(
          padding: EdgeInsets.zero,
          children: [
            const UserAccountsDrawerHeader(
              decoration: BoxDecoration(color: Color(0xFF1B4D3E)),
              accountName: Text('Coordenação Geral',
                  style: TextStyle(fontWeight: FontWeight.bold)),
              accountEmail: Text('paroquia.csjb@supabase.co'),
              currentAccountPicture: CircleAvatar(
                backgroundColor: Colors.white,
                child: Icon(Icons.church, color: Color(0xFF1B4D3E)),
              ),
            ),
            ListTile(
              leading: const Icon(Icons.person),
              title: const Text('Meu Perfil'),
              onTap: () => Navigator.pop(context),
            ),
            ListTile(
              leading: const Icon(Icons.settings),
              title: const Text('Configurações da Pastoral'),
              onTap: () => Navigator.pop(context),
            ),
            const Divider(),
            ListTile(
              leading: const Icon(Icons.logout, color: Colors.red),
              title: const Text('Sair do Sistema',
                  style: TextStyle(color: Colors.red)),
              onTap: () async {
                await Supabase.instance.client.auth.signOut();
                if (context.mounted) {
                  Navigator.pushReplacement(
                    context,
                    MaterialPageRoute(builder: (_) => const TelaLoginGuard()),
                  );
                }
              },
            ),
          ],
        ),
      ),
      appBar: AppBar(
        backgroundColor: const Color(0xFFF9F8F3),
        elevation: 0,
        leading: Builder(
          builder: (context) => IconButton(
            icon: const Icon(Icons.menu, color: Colors.black87),
            onPressed: () => Scaffold.of(context).openDrawer(),
          ),
        ),
        title: const Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text('Coordenação',
                style: TextStyle(
                    color: Colors.black87,
                    fontWeight: FontWeight.bold,
                    fontSize: 18)),
            Text('PASTORAL DOS COROINHAS',
                style: TextStyle(
                    color: Colors.grey, fontSize: 10, letterSpacing: 0.8)),
          ],
        ),
        actions: [
          Padding(
            padding: const EdgeInsets.only(right: 16.0),
            child: CircleAvatar(
              radius: 18,
              backgroundColor: Colors.purple.shade100,
              child: const Text('AC',
                  style: TextStyle(
                      color: Colors.purple,
                      fontWeight: FontWeight.bold,
                      fontSize: 12)),
            ),
          )
        ],
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 8.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(meses[mesAtualIndex],
                    style: const TextStyle(
                        fontSize: 15, fontWeight: FontWeight.bold)),
                Row(
                  children: [
                    IconButton(
                      icon: const Icon(Icons.chevron_left, size: 22),
                      onPressed: mesAtualIndex > 0
                          ? () => setState(() => mesAtualIndex--)
                          : null,
                    ),
                    IconButton(
                      icon: const Icon(Icons.chevron_right, size: 22),
                      onPressed: mesAtualIndex < meses.length - 1
                          ? () => setState(() => mesAtualIndex++)
                          : null,
                    ),
                  ],
                )
              ],
            ),
            const SizedBox(height: 10),
            SizedBox(
              height: 70,
              child: ListView.builder(
                scrollDirection: Axis.horizontal,
                itemCount: diasSemana.length,
                itemBuilder: (context, index) {
                  final item = diasSemana[index];
                  final isSelected = index == diaSelecionadoIndex;

                  return GestureDetector(
                    onTap: () => setState(() => diaSelecionadoIndex = index),
                    child: Container(
                      width: 50,
                      margin: const EdgeInsets.only(right: 8),
                      decoration: BoxDecoration(
                        color: isSelected
                            ? const Color(0xFF23473B)
                            : Colors.transparent,
                        borderRadius: BorderRadius.circular(16),
                      ),
                      child: Column(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
