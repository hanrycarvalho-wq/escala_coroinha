                            foregroundColor: const Color(0xFF1B4D3E),
                            elevation: 0,
                            shape: RoundedRectangleBorder(
                                borderRadius: BorderRadius.circular(24)),
                          ),
                          onPressed: _copiarTextoWhatsApp,
                          icon: const Icon(Icons.copy_rounded, size: 18),
